  <!-- ══════════════════════════════════════════════════════════
       PAGE 4: Inbox
       ══════════════════════════════════════════════════════════ -->
  <diagram id="inbox" name="Inbox — Shared AP Inbox">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="POST /inbox — ActivityPub Shared Inbox Handler" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <mxCell id="req" value="Incoming Activity (JSON-LD)&#xa;{ @context, type, actor, object, … }" style="shape=mxgraph.flowchart.start_2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="switch" value="Switch on activity.type" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="req" target="switch"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Follow branch -->
        <mxCell id="follow-box" value="Follow&#xa;────────────────&#xa;Neo4j: MERGE (follower)-[:FOLLOWS]→(target)&#xa;Reply with Accept{Follow} activity&#xa;Deliver Accept via delivery.js" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-follow" value="Follow" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="switch" target="follow-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Undo branch -->
        <mxCell id="undo-box" value="Undo{Follow}&#xa;────────────────&#xa;Neo4j: MATCH (a)-[r:FOLLOWS]→(b)&#xa;DELETE r" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-undo" value="Undo" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="switch" target="undo-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Like branch -->
        <mxCell id="like-box" value="Like&#xa;────────────────&#xa;Neo4j: MATCH (r:Review {apId})&#xa;SET r.likeCount += 1&#xa;MERGE (actor)-[:LIKES]→(r)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="600" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-like" value="Like" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="switch" target="like-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Announce branch -->
        <mxCell id="ann-box" value="Announce&#xa;────────────────&#xa;Neo4j: MERGE (actor)-[:BOOSTED]→(r)&#xa;WHERE r.apId = object" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="840" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-ann" value="Announce" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="switch" target="ann-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Create branch -->
        <mxCell id="create-box" value="Create{Note}&#xa;────────────────&#xa;Neo4j: CREATE (r:Review {…})&#xa;MERGE (author)-[:AUTHORED]→(r)&#xa;MERGE (r)-[:REVIEWS]→(book)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e-create" value="Create" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="switch" target="create-box"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 202 -->
        <mxCell id="r202" value="202 Accepted (all branches)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="460" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e-f1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="follow-box" target="r202"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="undo-box" target="r202"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="like-box" target="r202"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f4" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ann-box" target="r202"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-f5" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="create-box" target="r202"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

