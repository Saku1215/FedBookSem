  <diagram id="delivery" name="Delivery — HTTP Signatures">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="delivery.js — Signed ActivityPub Dispatch" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <mxCell id="call" value="deliverActivity(activity, targetInbox, senderUsername)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="neo1" value="Neo4j: MATCH (p:Person {senderUsername})&#xa;RETURN p.privateKey" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="call" target="neo1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="headers" value="Build HTTP headers:&#xa;• Date: RFC 1123 timestamp&#xa;• Host: target hostname&#xa;• Digest: SHA-256 of body (base64)&#xa;• Content-Type: application/activity+json" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="265" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="neo1" target="headers"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sig" value="Build signing string:&#xa;'(request-target): post /inbox\nhost: …\ndate: …\ndigest: …'&#xa;&#xa;node-forge: RSA-SHA256 sign&#xa;Base64-encode signature&#xa;&#xa;Signature header:&#xa;keyId=…,algorithm=rsa-sha256,&#xa;headers=…,signature=…" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="300" y="415" width="320" height="155" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="headers" target="sig"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="post" value="axios.post(targetInbox, activity, {&#xa;  headers, timeout: 5000&#xa;})" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="610" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sig" target="post"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="ok" value="Success (2xx)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="710" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="err" value="Error logged (non-fatal)&#xa;server does not crash" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="710" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="success" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="post" target="ok"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="error" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="post" target="err"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

