       PAGE 6: Reviews
       ══════════════════════════════════════════════════════════ -->
  <diagram id="reviews" name="Reviews — CRUD + Federation">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Reviews Route — /api/reviews" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <!-- POST /reviews -->
        <mxCell id="post-title" value="POST /api/reviews (auth required)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="post-body" value="1. Validate isbn, content, rating (1-5)&#xa;2. Neo4j: CREATE (r:Review {id,content,rating,apId})&#xa;3. MERGE (user)-[:AUTHORED]→(r)&#xa;4. MERGE (r)-[:REVIEWS]→(book)&#xa;5. Build Create{Note} AP activity&#xa;6. deliverActivity() to all book followers&#xa;7. Return 201 { review }" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="280" height="140" as="geometry" />
        </mxCell>

        <!-- GET /reviews -->
        <mxCell id="get-title" value="GET /api/reviews?isbn=…" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="get-body" value="Neo4j: MATCH (r)-[:REVIEWS]→(b {isbn})&#xa;OPTIONAL MATCH (a)-[:AUTHORED]→(r)&#xa;RETURN r.*, a.username, a.displayName&#xa;ORDER BY r.createdAt DESC" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- DELETE /reviews/:id -->
        <mxCell id="del-title" value="DELETE /api/reviews/:id (auth)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="del-body" value="1. Verify JWT — must be review author&#xa;2. Neo4j: MATCH (r:Review {id}) DELETE r&#xa;3. Also DELETE [:AUTHORED], [:REVIEWS] edges&#xa;4. Return 204 No Content" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="260" height="80" as="geometry" />
        </mxCell>

        <!-- POST /reviews/:id/like -->
        <mxCell id="like-title" value="POST /api/reviews/:id/like (auth)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="like-body" value="Neo4j: MATCH (r:Review {id})&#xa;SET r.likeCount = r.likeCount + 1&#xa;MERGE (user)-[:LIKES]→(r)&#xa;Build Like activity → deliverActivity()&#xa;to review author's inbox" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="280" height="90" as="geometry" />
        </mxCell>

        <!-- POST /reviews/:id/announce -->
        <mxCell id="ann-title" value="POST /api/reviews/:id/announce (auth)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="320" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ann-body" value="Neo4j: MERGE (user)-[:BOOSTED]→(r)&#xa;Build Announce activity&#xa;deliverActivity() to user's followers" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="380" y="360" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- POST /reviews/:id/reply -->
        <mxCell id="rep-title" value="POST /api/reviews/:id/reply (auth)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="320" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rep-body" value="Neo4j: CREATE (reply:Reply {id,content})&#xa;MERGE (user)-[:AUTHORED]→(reply)&#xa;MERGE (reply)-[:REPLY_TO]→(review)&#xa;Build Create{Note} with inReplyTo AP field&#xa;deliverActivity() to original author" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="700" y="360" width="260" height="100" as="geometry" />
        </mxCell>

        <!-- Node legend -->
        <mxCell id="leg" value="Nodes touched: Person (READ), Book (READ), Review (READ/WRITE), Reply (WRITE)&#xa;Edges: AUTHORED (WRITE), REVIEWS (WRITE), LIKES (WRITE), BOOSTED (WRITE), REPLY_TO (WRITE)" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="820" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════
       PAGE 7: Annotations
       ══════════════════════════════════════════════════════════ -->
  <diagram id="annotations" name="Annotations — W3C Web Annotation">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Annotations Route — /api/annotations (W3C Web Annotation)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="960" height="36" as="geometry" />
        </mxCell>

        <!-- POST /annotations -->
        <mxCell id="post-title" value="POST /api/annotations (auth)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="post-body" value="Request body (W3C format):&#xa;{ bodyValue, motivation,&#xa;  target: { isbn, selector: [&#xa;    { type: TextQuoteSelector,&#xa;      exact, prefix, suffix },&#xa;    { type: TextPositionSelector,&#xa;      start, end }&#xa;  ]} }&#xa;&#xa;Neo4j: CREATE (a:Annotation {id,&#xa;  bodyValue, motivation, quoteExact,&#xa;  quotePrefix, quoteSuffix,&#xa;  positionStart, positionEnd, apId})&#xa;&#xa;MERGE (user)-[:ANNOTATED]→(a)&#xa;MERGE (a)-[:ON_SOURCE]→(book)&#xa;&#xa;Return 201 with W3C JSON-LD" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="300" height="300" as="geometry" />
        </mxCell>

        <!-- GET /annotations -->
        <mxCell id="get-title" value="GET /api/annotations?isbn=…" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="get-body" value="Neo4j:&#xa;MATCH (a:Annotation)-[:ON_SOURCE]→(b {isbn})&#xa;OPTIONAL MATCH (p)-[:ANNOTATED]→(a)&#xa;RETURN a.*, p.username&#xa;ORDER BY a.createdAt DESC&#xa;&#xa;Each result reconstructed as W3C&#xa;Annotation JSON-LD with selectors" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="300" height="150" as="geometry" />
        </mxCell>

        <!-- GET /annotations/:id/thread -->
        <mxCell id="thread-title" value="GET /api/annotations/:id/thread" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="thread-body" value="Neo4j:&#xa;MATCH (a:Annotation {id})&#xa;OPTIONAL MATCH (a)-[:REPLY_TO*]→(parent)&#xa;OPTIONAL MATCH (child)-[:REPLY_TO]→(a)&#xa;RETURN a, parent, [child]&#xa;&#xa;Returns threaded annotation tree" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="740" y="120" width="280" height="130" as="geometry" />
        </mxCell>

        <!-- DELETE /annotations/:id -->
        <mxCell id="del-title" value="DELETE /api/annotations/:id (auth)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="del-body" value="Verify JWT — must be annotation author&#xa;Neo4j: MATCH (a:Annotation {id})&#xa;DETACH DELETE a&#xa;Return 204" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- W3C format box -->
        <mxCell id="w3c" value="W3C JSON-LD Response Shape:&#xa;{&#xa;  '@context': 'http://www.w3.org/ns/anno.jsonld',&#xa;  type: 'Annotation',&#xa;  id: BASE_URL/annotations/uuid,&#xa;  motivation: 'commenting',&#xa;  body: { type: 'TextualBody', value: '…' },&#xa;  target: {&#xa;    source: BASE_URL/books/isbn,&#xa;    selector: [ TextQuoteSelector, TextPositionSelector ]&#xa;  },&#xa;  creator: BASE_URL/users/username&#xa;}" style="rounded=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="500" height="200" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Nodes: Person (READ), Book (READ), Annotation (READ/WRITE)&#xa;Edges: ANNOTATED (WRITE), ON_SOURCE (WRITE)" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="700" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════
       PAGE 8: Books
       ══════════════════════════════════════════════════════════ -->
  <diagram id="books" name="Books — Catalogue API">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Books Route — /api/books" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <!-- GET /books -->
        <mxCell id="all-title" value="GET /api/books" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="all-body" value="Neo4j:&#xa;MATCH (b:Book)&#xa;RETURN b.isbn, b.title, b.author,&#xa;  b.year, b.coverUrl&#xa;ORDER BY b.title ASC&#xa;&#xa;Returns array of all books" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- GET /books/:isbn -->
        <mxCell id="one-title" value="GET /api/books/:isbn" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="one-body" value="Neo4j:&#xa;MATCH (b:Book {isbn})&#xa;RETURN b.*&#xa;&#xa;If not found → 404&#xa;Returns single book object" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="120" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- GET /books/:isbn/reviews -->
        <mxCell id="rev-title" value="GET /api/books/:isbn/reviews" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="80" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rev-body" value="Neo4j:&#xa;MATCH (r:Review)-[:REVIEWS]→(b {isbn})&#xa;OPTIONAL MATCH (a:Person)-[:AUTHORED]→(r)&#xa;OPTIONAL MATCH ()-[l:LIKES]→(r)&#xa;RETURN r.id, r.content, r.rating,&#xa;  a.username, a.displayName,&#xa;  COUNT(l) AS likeCount&#xa;ORDER BY r.createdAt DESC&#xa;&#xa;Returns reviews with author info" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="300" height="160" as="geometry" />
        </mxCell>

        <!-- covers route link -->
        <mxCell id="cover-note" value="GET /api/covers/:isbn — SVG Cover Generator" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cover-body" value="Neo4j: MATCH (b:Book {isbn}) RETURN b.title, b.author&#xa;&#xa;Generates SVG:&#xa;• Palette selected by isbn hash (5 colour themes)&#xa;• Renders title, author, decorative lines&#xa;• Content-Type: image/svg+xml&#xa;• Cache-Control: public, max-age=86400&#xa;&#xa;Used as fallback when coverUrl is null" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="400" height="155" as="geometry" />
        </mxCell>

        <mxCell id="leg" value="Nodes: Book (READ), Review (READ), Person (READ)&#xa;Edges: REVIEWS (READ), AUTHORED (READ), LIKES (COUNT)" style="text;html=1;strokeColor=#666;fillColor=#f5f5f5;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="600" height="40" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════
       PAGE 9: Social Graph
       ══════════════════════════════════════════════════════════ -->
  <diagram id="social" name="Social — Follow Graph">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Social Routes + social.js Graph Helpers — /api/social" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="960" height="36" as="geometry" />
        </mxCell>

        <!-- follow() -->
        <mxCell id="f-title" value="POST /api/social/follow (auth)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f-body" value="social.follow(follower, target)&#xa;────────────────────&#xa;Neo4j:&#xa;MATCH (a:Person {username: follower})&#xa;MATCH (b:Person {username: target})&#xa;MERGE (a)-[:FOLLOWS]→(b)&#xa;&#xa;If target is remote (different domain):&#xa;Build Follow activity&#xa;deliverActivity() to target inbox" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- unfollow() -->
        <mxCell id="uf-title" value="POST /api/social/unfollow (auth)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="uf-body" value="social.unfollow(follower, target)&#xa;────────────────────&#xa;Neo4j:&#xa;MATCH (a)-[r:FOLLOWS]→(b)&#xa;WHERE a.username=$follower&#xa;  AND b.username=$target&#xa;DELETE r&#xa;&#xa;If remote: Build Undo{Follow}&#xa;deliverActivity()" style="rounded=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="260" height="170" as="geometry" />
        </mxCell>

        <!-- GET users -->
        <mxCell id="u-title" value="GET /api/social/users" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u-body" value="social.getAllUsers()&#xa;────────────────────&#xa;Neo4j:&#xa;MATCH (p:Person)&#xa;WHERE p.domain = $localDomain&#xa;RETURN p.username, p.displayName,&#xa;  p.bio, p.avatarUrl" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- GET followers/following -->
        <mxCell id="ff-title" value="GET /api/social/:u/followers|following" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ff-body" value="getFollowers(u) / getFollowing(u)&#xa;────────────────────&#xa;Neo4j: MATCH (p)-[:FOLLOWS]→(u)&#xa;RETURN p.* (followers)&#xa;&#xa;Neo4j: MATCH (u)-[:FOLLOWS]→(p)&#xa;RETURN p.* (following)" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="960" y="120" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- recommend -->
        <mxCell id="rec-title" value="recommendBooks(username)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rec-body" value="Friend-of-friend Cypher traversal:&#xa;MATCH (me)-[:FOLLOWS]→(friend)&#xa;  -[:FOLLOWS]→(fof)&#xa;MATCH (fof)-[:AUTHORED]→(r)&#xa;  -[:REVIEWS]→(b)&#xa;WHERE NOT (me)-[:AUTHORED]→(:Review)&#xa;  -[:REVIEWS]→(b)&#xa;RETURN DISTINCT b.*, score&#xa;ORDER BY score DESC LIMIT 10" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="320" height="160" as="geometry" />
        </mxCell>

        <!-- booksLikedByFollowed -->
        <mxCell id="bl-title" value="booksLikedByFollowed(username)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="360" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bl-body" value="MATCH (me)-[:FOLLOWS]→(friend)&#xa;MATCH (friend)-[:LIKES]→(r)&#xa;  -[:REVIEWS]→(b)&#xa;RETURN DISTINCT b.*,&#xa;  COLLECT(friend.username) AS likedBy&#xa;ORDER BY likedBy DESC LIMIT 10" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="420" y="400" width="280" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════
       PAGE 10: Feed
       ══════════════════════════════════════════════════════════ -->
  <diagram id="feed" name="Feed — Personalised Timeline">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Feed Route — /api/feed" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <!-- GET /feed (personalised) -->
        <mxCell id="f1-title" value="GET /api/feed (auth required)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f1-body" value="social.getTimeline(username)&#xa;────────────────────&#xa;Neo4j:&#xa;MATCH (me)-[:FOLLOWS]→(friend)&#xa;MATCH (friend)-[:AUTHORED]→(r:Review)&#xa;MATCH (r)-[:REVIEWS]→(b:Book)&#xa;RETURN DISTINCT r.*, friend.*,&#xa;  b.isbn, b.title, b.coverUrl&#xa;ORDER BY r.createdAt DESC&#xa;LIMIT 50&#xa;&#xa;Returns personalised timeline" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="300" height="210" as="geometry" />
        </mxCell>

        <!-- GET /feed/all (discover) -->
        <mxCell id="f2-title" value="GET /api/feed/all (public)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f2-body" value="social.getAllReviews()&#xa;────────────────────&#xa;Neo4j:&#xa;MATCH (r:Review)&#xa;MATCH (r)-[:REVIEWS]→(b)&#xa;OPTIONAL MATCH (a)-[:AUTHORED]→(r)&#xa;RETURN DISTINCT r.*, a.*, b.*&#xa;ORDER BY r.createdAt DESC" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="280" height="160" as="geometry" />
        </mxCell>

        <!-- GET /feed/recommendations -->
        <mxCell id="f3-title" value="GET /api/feed/recommendations (auth)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f3-body" value="Calls social.recommendBooks(username)&#xa;and social.booksLikedByFollowed(username)&#xa;────────────────────&#xa;Merges and deduplicates results&#xa;Returns book list with scores" style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="300" height="120" as="geometry" />
        </mxCell>

        <!-- GET /feed/liked-by-followed -->
        <mxCell id="f4-title" value="GET /api/feed/liked-by-followed (auth)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="360" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="f4-body" value="Calls social.booksLikedByFollowed(username)&#xa;Returns books liked by people you follow&#xa;with list of who liked each book" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="400" width="300" height="80" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ══════════════════════════════════════════════════════════
       PAGE 11: Users / Profiles
       ══════════════════════════════════════════════════════════ -->
  <diagram id="users" name="Users — Profiles &amp; Avatars">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="Users Route — /api/users (Profiles + Avatar Uploads)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="960" height="36" as="geometry" />
        </mxCell>

        <!-- GET /users/:username -->
        <mxCell id="g-title" value="GET /api/users/:username" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-body" value="Neo4j: MATCH (p:Person {username})&#xa;RETURN p.*&#xa;&#xa;getFollowers(u) → follower count&#xa;getFollowing(u) → following count&#xa;getUserReviews(u) → recent reviews&#xa;&#xa;Returns full profile object:&#xa;{ username, displayName, bio,&#xa;  avatarUrl, followerCount,&#xa;  followingCount, reviews }" style="rounded=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="300" height="185" as="geometry" />
        </mxCell>

        <!-- PUT /users/:username -->
        <mxCell id="p-title" value="PUT /api/users/:username (auth)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="280" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p-body" value="updateUserProfile(username, data)&#xa;────────────────────&#xa;Validates JWT owns username&#xa;&#xa;Neo4j:&#xa;MATCH (p:Person {username})&#xa;SET p.displayName = $displayName,&#xa;  p.bio = $bio&#xa;&#xa;Returns updated profile" style="rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="120" width="280" height="155" as="geometry" />
        </mxCell>

        <!-- POST /users/:username/avatar -->
        <mxCell id="a-title" value="POST /api/users/:username/avatar (auth)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="320" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a-body" value="Multer config:&#xa;• dest: backend/public/avatars/&#xa;• limits: 4 MB&#xa;• filter: image/* MIME only&#xa;&#xa;On upload success:&#xa;Neo4j: SET p.avatarUrl = $filename&#xa;&#xa;Static serving: /avatars/*&#xa;Helmet crossOriginResourcePolicy: cross-origin&#xa;&#xa;Returns { avatarUrl: '/avatars/filename.jpg' }" style="rounded=0;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="320" height="185" as="geometry" />
        </mxCell>

        <!-- multer diagram -->
        <mxCell id="multer-flow" value="Multer Upload Pipeline" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="multipart/form-data request" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="Multer middleware&#xa;validates MIME + size" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="Saved to disk:&#xa;public/avatars/uuid.ext" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="530" width="220" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="Neo4j p.avatarUrl updated" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e-m1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m2" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-m3" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

