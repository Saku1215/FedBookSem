  <!-- ══════════════════════════════════════════════════════════
       PAGE 1: Authentication  (POST /api/auth/login)
       ══════════════════════════════════════════════════════════ -->
  <diagram id="auth" name="Auth — Login">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="t" value="POST /api/auth/login — Authentication Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="760" height="36" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Client&#xa;{ username, password }" style="shape=mxgraph.flowchart.start_2;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Validate input -->
        <mxCell id="v1" value="Validate body&#xa;username &amp; password present?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="180" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e-v1" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="client" target="v1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 400 -->
        <mxCell id="r400" value="400 Bad Request&#xa;'username and password required'" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="195" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-400" value="No" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v1" target="r400"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Neo4j lookup -->
        <mxCell id="neo1" value="Neo4j: MATCH (p:Person)&#xa;WHERE p.username = $username&#xa;RETURN p" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-neo1" value="Yes" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="v1" target="neo1"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 404 -->
        <mxCell id="r404" value="404 Not Found&#xa;'User not found'" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="315" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-404" value="null" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="neo1" target="r404"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- bcrypt -->
        <mxCell id="bcrypt" value="bcrypt.compare(&#xa;  password, p.passwordHash)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="410" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-bcrypt" value="found" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="neo1" target="bcrypt"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 401 -->
        <mxCell id="r401" value="401 Unauthorized&#xa;'Invalid credentials'" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="425" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e-401" value="false" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="bcrypt" target="r401"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- JWT sign -->
        <mxCell id="jwt" value="jwt.sign(&#xa;  { sub: username, domain },&#xa;  JWT_SECRET, { expiresIn: '7d' })" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="455" y="520" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-jwt" value="true" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="bcrypt" target="jwt"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- 200 -->
        <mxCell id="r200" value="200 OK&#xa;{ token, actor: { username,&#xa;  displayName, domain, … } }" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="270" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-200" value="" style="edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="jwt" target="r200"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>

