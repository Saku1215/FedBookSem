DOMAIN=localhost:3001
BASE_URL=http://localhost:3001

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

POSTGRES_URL=postgresql://fedbooksem:your_password@localhost:5432/fedbooksem

REDIS_URL=redis://localhost:6379

JWT_SECRET=your_jwt_secret_change_in_production

PORT=3001

# ML service (fedbook-ml) - Python FastAPI recommender
# When running under docker-compose the backend can reach the ml-service on its container name
ML_SERVICE_URL=http://ml-service:8000

# Hardcover live star ratings (also in ml-service/.env). Grab a token from
# https://hardcover.app/account/api. Leave blank to disable the ★ chip.
HARDCOVER_API_TOKEN=
