NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fedbooksem123
OPENLIBRARY_USER_AGENT=FedBook-Sem/0.1 (sanjaya.w@jinasena.com.lk)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOG_LEVEL=INFO

# --- Slice B (live ground-truth ratings) ---
# Hardcover GraphQL - free, beta. Token via https://hardcover.app/account/api
# Leave empty to disable the ★ rating chip in book cards. Missing/expired
# tokens fail gracefully (the recommender still returns semantic + reception).
HARDCOVER_API_TOKEN=

# --- Slice C (cross-platform ingestion) ---
# Comma-separated Mastodon instances to poll for #bookstodon posts.
# Reads a hashtag timeline per instance - unauthenticated, per-IP rate limit.
MASTODON_INSTANCES=mastodon.social,ohai.social

# Reddit - requires post-Nov-2025 Responsible Builder Policy approval OR
# pre-Nov-2025 OAuth credentials. Blank = Reddit collector skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FedBook-Sem/0.1 (research)

# YouTube - Google Cloud API key with YouTube Data API v3 enabled.
YOUTUBE_API_KEY=

# Bluesky - not required for public searchPosts on public.api.bsky.app.
# Only fill in if you plan to authenticated writes (we don't).
BSKY_HANDLE=
BSKY_APP_PASSWORD=
